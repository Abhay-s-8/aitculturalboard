rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console > Firestore Database > Rules)
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'culturalboardait85@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'message', 'date', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.message is string && d.message.size() <= 1000
        && d.date is string && d.date.size() <= 10
        && d.createdAt == request.time;
    }

    // Anyone may read announcements; only the admin may change them.
    match /announcements/{id} {
      allow read: if true;
      allow create: if isAdmin() && validAnnouncement();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
